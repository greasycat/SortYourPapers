#!/usr/bin/env bash
#
# Run the watcher as a background service via launchd.
#
#   ./prototype/scripts/sypy-service install [watch-name]
#   ./prototype/scripts/sypy-service install [watched-folder] [library-folder]
#   ./prototype/scripts/sypy-service status
#   ./prototype/scripts/sypy-service logs
#   ./prototype/scripts/sypy-service uninstall
#
# With no arguments it runs the registry's default watch, so the folders and the
# mode are declared in one place (`sypy watches`) rather than repeated here.
# Given a name it runs that watch. Given two paths it runs them directly,
# without the registry. Override the mode with SYPY_MODE=move.
set -euo pipefail

LABEL="com.sortyourpapers.sypy"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="${SYPY_VENV_DIR:-$PROJECT_DIR/.venv}"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="${SYPY_LOG_DIR:-$HOME/Library/Logs/sypy}"
# The watcher's own log, written through a rotating handler so a service left
# running for months cannot fill the disk.
LOG_FILE="$LOG_DIR/sypy.log"
# What launchd captures from the process: a traceback if it dies, and nothing
# else, because the log itself goes to $LOG_FILE. Small enough to leave alone.
CRASH_FILE="$LOG_DIR/sypy.crash.log"
MODE="${SYPY_MODE:-copy}"
DOMAIN="gui/$(id -u)"

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
note() { printf '%s\n' "$1"; }

is_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }

# The folder the installed agent watches, read back from its own plist so it
# reflects what is actually running rather than what this invocation was asked
# for.
watched_folder_of_running_service() {
  [ -f "$PLIST" ] || return 0
  /usr/bin/python3 - "$PLIST" <<'PY' 2>/dev/null || true
import plistlib, sys
with open(sys.argv[1], "rb") as handle:
    args = plistlib.load(handle).get("ProgramArguments", [])
if "--input" in args:
    print(args[args.index("--input") + 1])
PY
}

install_service() {
  [ -x "$VENV_DIR/bin/sypy" ] || die "sypy is not installed; run scripts/sypy-path wire first"

  local watched library
  if [ "$#" -le 1 ]; then
    # No paths given, so the registry is the authority on what to watch.
    local declared
    declared="$("$VENV_DIR/bin/sypy" watch-target ${1:+"$1"} 2>&1)" || die "$declared"
    watched="${declared%%$'\n'*}"
    library="${declared##*$'\n'}"
    [ -n "$watched" ] && [ -n "$library" ] || die "could not resolve a watch to install"
  else
    watched="$1"
    library="$2"
  fi

  [ -d "$watched" ] || die "watched folder does not exist: $watched"
  case "$MODE" in
    copy|move) ;;
    *) die "SYPY_MODE must be copy or move, got '$MODE'" ;;
  esac

  # One agent, one label: installing for a different folder would replace the
  # running service without saying so, leaving the user believing both folders
  # were watched. Reinstalling the same folder is how config changes are picked
  # up, so that stays allowed.
  if is_loaded; then
    running_watched="$(watched_folder_of_running_service)"
    if [ -n "$running_watched" ] && [ "$running_watched" != "$watched" ]; then
      die "a service is already watching $running_watched
  installing this one would silently replace it. Run '$(basename "$0") uninstall' first."
    fi
    note "replacing the running service"
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
  fi

  mkdir -p "$LOG_DIR" "$library" "$(dirname "$PLIST")"

  # Carry the directory holding pdftoppm into the agent's environment; a bare
  # launchd PATH would leave scanned PDFs failing silently.
  local RUNTIME_PATH="/usr/bin:/bin:/usr/sbin:/sbin"
  local poppler_bin
  poppler_bin="$(dirname "$(command -v pdftoppm 2>/dev/null || echo /nonexistent/x)")"
  if [ -d "$poppler_bin" ]; then
    RUNTIME_PATH="$poppler_bin:$RUNTIME_PATH"
  else
    note "warning: pdftoppm not found; scanned PDFs will be reported as failures"
  fi

  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$VENV_DIR/bin/sypy</string>
        <string>watch</string>
        <string>--input</string><string>$watched</string>
        <string>--library</string><string>$library</string>
        <string>--mode</string><string>$MODE</string>
    </array>
    <key>WorkingDirectory</key><string>$PROJECT_DIR</string>
    <!-- launchd gives an agent a bare PATH, which does not include Homebrew.
         Without this, pdftoppm is not found and every scanned PDF fails while
         the same command works by hand. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$RUNTIME_PATH</string>
        <!-- Sends the log through a rotating handler. Without it every line
             lands in the launchd capture below, which nothing ever trims. -->
        <key>SYPY_LOG_FILE</key><string>$LOG_FILE</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>$CRASH_FILE</string>
    <key>StandardErrorPath</key><string>$CRASH_FILE</string>
</dict>
</plist>
PLIST_EOF

  launchctl bootstrap "$DOMAIN" "$PLIST" || die "launchctl bootstrap failed"
  note "installed $LABEL"
  note "  watching : $watched"
  note "  library  : $library"
  note "  mode     : $MODE"
  note "  logs     : $LOG_FILE"
  note "  crashes  : $CRASH_FILE"
}

uninstall_service() {
  if is_loaded; then
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    note "stopped $LABEL"
  else
    note "$LABEL was not running"
  fi
  if [ -f "$PLIST" ]; then
    rm -f "$PLIST"
    note "removed $PLIST"
  fi
  note "the library and its logs are left in place"
}

case "${1:-}" in
  install) shift; install_service "$@" ;;
  uninstall) uninstall_service ;;
  status)
    if is_loaded; then
      launchctl print "$DOMAIN/$LABEL" | grep -E "^\s+(state|pid|last exit code) " || true
    else
      note "$LABEL is not loaded"
    fi
    ;;
  logs)
    [ -f "$LOG_FILE" ] && tail -n "${2:-40}" "$LOG_FILE" || note "no log at $LOG_FILE"
    # A crash never reaches the rotating log: the process is gone before the
    # handler could write it. Say so here rather than leaving the last thing
    # that happened in a file nobody looks at.
    if [ -s "$CRASH_FILE" ]; then
      note ""
      note "--- $CRASH_FILE (crashes, not rotated) ---"
      tail -n 20 "$CRASH_FILE"
    fi
    ;;
  *)
    printf 'usage: %s {install [watched] [library]|uninstall|status|logs [n]}\n' \
      "$(basename "$0")" >&2
    printf '\n  defaults: watch ~/Downloads -> ~/Documents/sypy-library, mode=%s\n' "$MODE" >&2
    printf '  override mode with SYPY_MODE=move\n' >&2
    exit 2
    ;;
esac
